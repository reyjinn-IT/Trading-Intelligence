# Indodax API (Secret key opsional/kosong untuk mode analisis)
INDODAX_API_KEY=your_indodax_api_key
INDODAX_SECRET_KEY=

# Mode Trading: false = Paper Trading (simulasi aman), true = Live Trading
LIVE_TRADING=false

# Bobot Konfluensi (Total 1.0 / 100%)
WEIGHT_TREND=0.40
WEIGHT_SND=0.30
WEIGHT_MACRO=0.30
MIN_CONFLUENCE_BUY_SCORE=70.0
MIN_CONFLUENCE_SELL_SCORE=70.0

# Manajemen Risiko
MAX_RISK_PER_TRADE_PERCENT=2.0
MIN_RISK_REWARD_RATIO=2.0

# Pengaman Deadman Switch
DEADMAN_TIMEOUT_SEC=30
ENABLE_DEADMAN_SWITCH=true

# Server Web
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
